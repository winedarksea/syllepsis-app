# Cloudflare Pages headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Fingerprinted, immutable assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# downloads.json changes each release — keep it fresh.
/downloads.json
  Cache-Control: public, max-age=300, must-revalidate
