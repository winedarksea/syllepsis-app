{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syllepsis",
  "version": "0.1.0",
  "identifier": "com.syllepsis.app",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "../scripts/prepare-bundled-models.sh && npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "Syllepsis",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["syllepsis"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/winedarksea/syllepsis-app/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBLIC_KEY"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../plugins/dist": "plugins",
      "bundled-models": "models"
    }
  }
}
